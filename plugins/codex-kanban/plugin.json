{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-kanban",
  "version": "0.4.44",
  "author": {"name": "shichang4fun", "url": "https://github.com/shichang4fun"},
  "repository": "https://github.com/shichang4fun/codex-kanban",
  "description": "A Codex sidebar MCP App with Desktop-owned groups, pinning, live runtime and archive Undo.",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Codex Kanban",
        "shortDescription": "从侧栏打开本机 Codex 任务看板",
        "longDescription": "本地 MCP App 看板，读取本机任务与项目，支持 Desktop 分组移动、置顶、归档与 Undo。实时运行状态通过所属桌面连接读取，断线后过期。支持看板、列表、筛选和详情。",
        "developerName": "shichang4fun",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "brandColor": "#9590ff",
        "composerIcon": "./assets/kanban-icon.png",
        "logo": "./assets/kanban-icon.png",
        "composerIconDark": "./assets/kanban-icon-dark.png",
        "logoDark": "./assets/kanban-icon-dark.png",
        "defaultPrompt": [
          "刷新我的 Codex Kanban",
          "查看正在运行和等待处理的 Codex 任务"
        ]
      }
    }
  }
}
